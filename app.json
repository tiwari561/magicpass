{
  "expo": {
    "name": "MagicPass",
    "slug": "magicpass",
    "version": "1.0.0",
    "newArchEnabled": false,
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "backgroundColor": "#1a56db"
    },
    "assetBundlePatterns": ["**/*"],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.genierealty.magicpass"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#1a56db"
      },
      "package": "com.genierealty.magicpass"
    },
    "plugins": [
      "expo-router",
      [
        "expo-camera",
        {
          "cameraPermission": "Allow MagicPass to access your camera to scan property QR codes."
        }
      ]
    ],
    "scheme": "magicpass",
    "experiments": {
      "typedRoutes": true
    }
  }
}
